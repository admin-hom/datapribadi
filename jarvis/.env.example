# Key AI gratis — isi salah SATU saja.
# Simpan file ini sebagai .env.local (huruf kecil, di folder jarvis/).

# Groq — paling cepat, 1.000 request/hari. Key: https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini — free tier, limit per project di AI Studio. Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter — model berakhiran :free, 50 request/hari. Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Opsional
# AI_PROVIDER=groq            # paksa provider tertentu (groq | gemini | openrouter)
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# PORT=8788
